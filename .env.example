# Lokale Defaults für die eigenständige Dateninfrastruktur-Grundinstallation.
# Diese Datei enthält keine Geheimnisse. ./scripts/init.sh erzeugt die lokale
# .env mit Zufallswerten; vorhandene Werte werden nie automatisch ersetzt.

COMPOSE_PROJECT_NAME=dateninfrastruktur-dev-stack
RUNTIME_DIR=.runtime/dateninfrastruktur-dev-stack

# Ausschliesslich Loopback-Ports. Bei einem isolierten Reviewlauf alle Werte
# zusammen mit COMPOSE_PROJECT_NAME und RUNTIME_DIR ändern.
GATEWAY_PORT=18081
GARAGE_S3_PORT=13900
KEYCLOAK_PORT=18080
SUPERSET_PORT=18088
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000

JENKINS_IMAGE=dateninfrastruktur-jenkins:local
SODATA_IMAGE=dateninfrastruktur-sodata:local
SUPERSET_IMAGE=dateninfrastruktur-superset:local
THEMEN_REPO_BRANCH=main

CLICKHOUSE_ADMIN_USER=ch_admin
CLICKHOUSE_SUPERSET_USER=superset_reader

# Die folgenden Werte werden ausschliesslich durch ./scripts/init.sh erzeugt
# und dürfen nicht in Git oder Berichte gelangen:
# GARAGE_DEFAULT_ACCESS_KEY, GARAGE_DEFAULT_SECRET_KEY
# GARAGE_BROWSER_ACCESS_KEY, GARAGE_BROWSER_SECRET_KEY
# PRIVATE_TEST_OBJECT_ID
# DATENINFRASTRUKTUR_PORTAL_RELOAD_TOKEN
# POSTGRES_ADMIN_PASSWORD
# KEYCLOAK_DB_PASSWORD, KEYCLOAK_ADMIN_PASSWORD, KEYCLOAK_DEMO_PASSWORD
# SUPERSET_DB_PASSWORD, SUPERSET_ADMIN_PASSWORD, SUPERSET_SECRET_KEY
# CLICKHOUSE_ADMIN_PASSWORD, CLICKHOUSE_DEFAULT_PASSWORD
# CLICKHOUSE_TEST_READER_PASSWORD, CLICKHOUSE_SUPERSET_READER_PASSWORD
# JENKINS_ADMIN_PASSWORD
