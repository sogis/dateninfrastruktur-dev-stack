# The normal configuration is generated privately by ./scripts/init.sh under
# .runtime/<project>/runtime.env. This reference contains no credentials and is
# not an alternative runtime. Existing .env files remain migration sources.
COMPOSE_PROJECT_NAME=dateninfrastruktur-dev-stack
GATEWAY_PORT=18081
KEYCLOAK_PORT=18080
SUPERSET_PORT=18088
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
# All account keys/passwords, UUIDs, images, volumes and absolute RUNTIME_DIR
# are retained/generated by init or an explicitly verified migration.
