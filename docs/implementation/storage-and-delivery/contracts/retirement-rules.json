{
  "schemaVersion": 1,
  "repositories": {
    "dateninfrastruktur-dev-stack": {
      "absent": ["services/migration/*", "scripts/migration_*.py", "scripts/consolidation.py", "scripts/bootstrap*", "scripts/management/setup.sh", "scripts/management/up.sh"],
      "scan": [
        {"paths": ["compose.yaml", ".env.example", "services/jenkins/jenkins-stack.yaml"], "forbidden": ["CATALOG_SOURCE_TYPE", "EXPLORE_ENABLED", "DI_INGESTION_ENABLED", "DI_INGESTION_PROJECTIONENABLED", "PUBLICATION_MODE", "RELOAD_PORTAL", "GARAGE_(DEFAULT|ORIGIN|MANAGED)_(ACCESS_KEY|SECRET_KEY)", "di-managed-private", "migration-fixture"]},
        {"paths": ["README.md", "docs/operations.md"], "forbidden": ["scripts/management/(setup|up|test)\\.sh", "scripts/(bootstrap|consolidation)", "storageProfile", "legacyAccessUrl"]}
      ]
    },
    "dateninfrastruktur-admin": {
      "absent": ["scripts/managed_runtime.py", "scripts/identity_runtime.py", "scripts/managed_control.py", "scripts/legacy_import.py", "scripts/principal_identity_migration.py"],
      "scan": [
        {"paths": ["Dockerfile", "src/main/java/*"], "forbidden": ["di\\.ingestion\\.enabled", "projection-enabled", "storageProfile", "legacyAccessUrl", "legacy-import", "COPY scripts \\./scripts", "services/migration"]}
      ]
    },
    "dateninfrastruktur-sodata": {
      "absent": ["src/main/java/*/importxtf/*", "src/main/java/*/explore/*", "src/main/java/*/CatalogSnapshot*.java", "src/main/java/*/CatalogArtifactController.java", "src/main/java/*/CatalogReload*.java", "src/main/frontend/explore/*", "dev/stack/compose.yaml", "tools/test-container.py"],
      "scan": [
        {"paths": ["build.gradle", "Dockerfile", "src/main/java/*", "src/main/resources/application*.yml"], "forbidden": ["CatalogSnapshot", "SnapshotMode", "ManifestCatalogSource", "catalog\\.source-type", "reload-token", "lucene", "include-catalog-download-origin"]}
      ]
    },
    "dateninfrastruktur-jenkins-dev": {
      "absent": ["bin/test-image-publication.sh", "tests/publication/*", "bin/build-offline-bundle.sh"],
      "scan": [
        {"paths": ["Dockerfile", "docker-entrypoint.sh", "bin/prepare-image-context.sh"], "forbidden": ["METADATA_FILE", "PUBLICATION_MODE", "RELOAD_PORTAL", "jenkins-home/", "seed-datenportal"]}
      ]
    },
    "dateninfrastruktur-jenkins-gretl-plugin": {
      "absent": ["src/main/java/*/gretldatenportal/*", "src/main/resources/*/gretldatenportal/*"],
      "scan": [
        {"paths": ["src/main/java/*", "src/main/resources/*"], "forbidden": ["prepareDatenportalWorkspace", "TeamDirectory", "PermissionConfiguration", "DefaultGuiDefinitionFactory", "RELOAD_PORTAL"]}
      ]
    },
    "dateninfrastruktur-themenrepo": {
      "absent": ["*/gretl-datenportal-job.yaml", "shared/gretl-datenportal-*.yaml", "shared/Jenkinsfile", "shared/publication.properties", "shared/gradle/datenportal-*.gradle", "shared/gradle/organisation-common.gradle", "shared/sql/publication/*", "shared/xsl/opendata/*"],
      "scan": [
        {"paths": ["runner/*", "contracts/*"], "forbidden": ["METADATA_FILE", "PUBLICATION_MODE", "RELOAD_PORTAL", "gretl-datenportal-teams", "initializePublication"]}
      ]
    }
  }
}
